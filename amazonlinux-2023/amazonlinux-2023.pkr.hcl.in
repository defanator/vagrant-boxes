packer {
  required_version = ">= 1.14.0"
  required_plugins {
    vmware = {
      source  = "github.com/hashicorp/vmware"
      version = "~> 1"
    }
  }
}

source "vmware-vmx" "buildvm" {
  source_path      = "%%VMX_PATH%%"
  vm_name          = "%%VM_NAME%%"
  headless         = true
  communicator     = "ssh"
  ssh_username     = "vagrant"
  ssh_password     = "vagrant"
  ssh_timeout      = "10m"
  shutdown_command = "sudo /sbin/poweroff"
}

variable "pre_auxiliary_commands" {
  type    = string
  default = env("PRE_AUXILIARY_COMMANDS")
}

variable "post_auxiliary_commands" {
  type    = string
  default = env("POST_AUXILIARY_COMMANDS")
}

build {
  sources = ["source.vmware-vmx.buildvm"]

  provisioner "file" {
    source = "amazonlinux-2023.bootstrap.sh"
    destination = "/tmp/bootstrap.sh"
  }

  provisioner "file" {
    source = "cloud.cfg"
    destination = "/tmp/cloud.cfg"
  }

  provisioner "shell" {
    environment_vars = [
      "PRE_AUXILIARY_COMMANDS=${var.pre_auxiliary_commands}",
      "POST_AUXILIARY_COMMANDS=${var.post_auxiliary_commands}"
    ]
    inline = ["chmod +x /tmp/bootstrap.sh && sudo -E /tmp/bootstrap.sh"]
  }
}
