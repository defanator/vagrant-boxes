packer {
  required_version = ">= 1.14.0"
  required_plugins {
    vmware = {
      source  = "github.com/hashicorp/vmware"
      version = "~> 1"
    }
  }
}

source "vmware-iso" "buildvm" {
  iso_url          = "%%ISO_URL%%"
  iso_checksum     = "%%ISO_CHECKSUM%%"
  vm_name          = "%%VM_NAME%%"
  headless         = true
  guest_os_type    = "%%GUEST_OS_TYPE%%"
  version          = 22
  cores            = 2
  memory           = 4096
  disk_size        = 8000
  disk_adapter_type = "sata"
  network_adapter_type = "vmxnet3"
  usb              = true
  vmx_data = {
    # enable USB 3
    "usb_xhci.present" = "true"
    # enable serial port for using as a console
    "serial0.present" = "true"
    "serial0.startconnected" = "true"
    "serial0.yieldOnMsrRead" = "true"
    "serial0.fileType" = "network"
    "serial0.fileName" = "telnet://:7777"
  }
  http_directory   = "%%HTTP_DIRECTORY%%"

  # Unfortunately, packer can not use serial console for boot_command,
  # hence we will use shell-local provisioner to run all the bootstrapping.
  #
  # See these relevant issues for more context:
  #  - https://github.com/hashicorp/packer/issues/1004
  #  - https://github.com/hashicorp/packer/issues/7863
  #
  communicator     = "none"
  boot_wait        = "5s"
  boot_command     = [
    "<wait10>",
  ]
}

build {
  sources = ["source.vmware-iso.buildvm"]

  provisioner "shell-local" {
    script = "alpine-3.serial-bootstrap.sh"
  }
}
